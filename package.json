{
  "name": "@genfire/cli",
  "version": "0.11.0",
  "description": "Command-line interface for the GenFire generative media platform",
  "keywords": [
    "genfire",
    "cli",
    "ai",
    "video-generation",
    "image-generation",
    "agents"
  ],
  "homepage": "https://github.com/genfireai/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genfireai/cli.git"
  },
  "bugs": {
    "url": "https://github.com/genfireai/cli/issues"
  },
  "author": "GenFire Team",
  "license": "MIT",
  "type": "module",
  "bin": {
    "genfire": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@genfire/sdk": "^0.12.0",
    "commander": "^12.1.0",
    "ink": "^7.0.2",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "open": "^10.1.0",
    "react": "^19.2.5",
    "zustand": "^5.0.13"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
